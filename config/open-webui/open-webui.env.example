# Open WebUI environment (EXAMPLE, placeholders). Real file must NOT be committed (.env is git-ignored).
# Reference: https://docs.openwebui.com/reference/env-configuration
# Generate a long random value and keep it in the secret store:
WEBUI_SECRET_KEY=CHANGE_ME_IN_SECRET_STORE
# Engine connection (pick one, per ADR)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OPENAI_API_BASE_URL=http://127.0.0.1:8080/v1
# OPENAI_API_KEY=LOCAL_PLACEHOLDER
# Accounts (decided in M03-014 / M10-005)
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=pending
# Public URL (placeholder)
WEBUI_URL=https://AI_SERVER_HOSTNAME
